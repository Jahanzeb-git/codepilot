{
  "name": "codepilot-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codepilot Agentic IDE — minimal, dependency-light web client. No framework: hand-rolled DOM + a tiny pub/sub store. Monaco is the only heavy dependency, and it's the editor itself.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "monaco-editor": "^0.52.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
